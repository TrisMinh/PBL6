# Each standalone web runs the full mock experience by default. Opt into live later.
VITE_API_MODE=mock
# Leave empty for same-origin /api/v1 requests (recommended).
VITE_API_BASE_URL=
# Public origin of the separate Operator web. Local preview uses port 5174.
VITE_OPERATOR_ORIGIN=
# Vite development proxy only. Never place credentials in VITE_* variables.
API_PROXY_TARGET=http://localhost:5080
# Optional secure Power BI Service embed URL for the Operator audience.
VITE_OPERATOR_POWER_BI_EMBED_URL=
# For a single-operator report, match its PostgreSQL reader's organization ID.
VITE_OPERATOR_POWER_BI_ORGANIZATION_ID=
# Optional JSON object mapping organization UUIDs to secure Power BI embed URLs.
VITE_OPERATOR_POWER_BI_REPORTS=
# Enable the sample-data label only for a synthetic Operator preview.
VITE_OPERATOR_REPORT_DEMO=false
