# Copy to a protected file outside the repository and pass with --env-file.
POSTGRES_PASSWORD=replace-with-a-long-random-secret
RABBITMQ_PASSWORD=replace-with-a-long-url-safe-random-secret
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
API_ALLOWED_HOSTS=api.example.vn;customer.example.vn;ops.example.vn
CUSTOMER_ORIGIN=https://customer.example.vn
BACKOFFICE_ORIGIN=https://ops.example.vn
CUSTOMER_HTTP_PORT=8080
BACKOFFICE_HTTP_PORT=8081
SMTP_HOST=smtp.example.vn
SMTP_PORT=587
SMTP_FROM=noreply@example.vn
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
VNPAY_CHECKOUT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=replace-me
VNPAY_HASH_SECRET=replace-with-vnpay-secret
BACKUP_DIR=./backups
