# Copy to a protected file outside the repository and pass with --env-file.
POSTGRES_PASSWORD=replace-with-a-long-random-secret
RABBITMQ_PASSWORD=replace-with-a-long-url-safe-random-secret
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
# Set true after testing the HTTPS SMS adapter with a real number.
SEAT_REQUIRE_VERIFIED_PHONE=false
SMS_ENDPOINT=
SMS_TOKEN=
API_ALLOWED_HOSTS=api.example.vn;customer.example.vn;ops.example.vn
CUSTOMER_ORIGIN=https://customer.example.vn
CUSTOMER_HTTP_PORT=8080
SMTP_HOST=smtp.example.vn
SMTP_PORT=587
SMTP_FROM=noreply@example.vn
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
BACKUP_DIR=./backups

# SePay Payment Gateway: backend only; never prefix secrets with VITE_.
SEPAY_ENVIRONMENT=production
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# Independent shared secret, also configure SePay IPN auth type SECRET_KEY.
SEPAY_IPN_SECRET_KEY=
# Public HTTPS customer origin for SePay browser callbacks (no trailing path).
CUSTOMER_PUBLIC_ORIGIN=https://customer.example.vn
