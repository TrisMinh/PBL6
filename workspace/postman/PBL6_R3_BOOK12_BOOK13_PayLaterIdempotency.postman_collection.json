{"info":{"name":"PBL6 Round 3 booking idempotency replay and conflict","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"name":"Customer login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/auth/login","body":{"mode":"raw","raw":"{\"identifier\":\"seed.customer@example.test\",\"password\":\"CustomerPass1\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.response.to.have.status(200);pm.environment.set('t',pm.response.json().accessToken)"]}}]},{"name":"Read available seats for idempotency fixture","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{t}}"}],"url":"http://localhost:5080/api/v1/trips/01990a00-0000-7000-8000-000000000007/seats"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Available seat found',()=>{pm.response.to.have.status(200);const s=pm.response.json().seats.find(x=>x.status==='AVAILABLE');pm.expect(s).to.exist;pm.environment.set('seat',s.id)});pm.environment.set('p','01990a00-0000-7000-8000-000000000004');pm.environment.set('d','01990a00-0000-7000-8000-000000000005')"]}}]},{"name":"Hold idempotency test seat","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{t}}"},{"key":"Idempotency-Key","value":"pbl6-r3-book12-hold"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/trips/01990a00-0000-7000-8000-000000000007/seat-holds","body":{"mode":"raw","raw":"{\"seatIds\":[\"{{seat}}\"],\"pickupStopId\":\"{{p}}\",\"dropoffStopId\":\"{{d}}\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.response.to.have.status(201);pm.environment.set('hold',pm.response.json().holdToken)"]}}]},{"name":"BOOK-12 Create PAY_LATER booking with key K","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{t}}"},{"key":"Idempotency-Key","value":"pbl6-r3-book12-booking"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/bookings","body":{"mode":"raw","raw":"{\"holdToken\":\"{{hold}}\",\"contact\":{\"fullName\":\"PBL6 Idempotency Customer\",\"email\":\"seed.customer@example.test\",\"phone\":\"+840000000001\"},\"passengers\":[{\"seatId\":\"{{seat}}\",\"fullName\":\"PBL6 Idempotency Passenger\",\"pickupStopId\":\"{{p}}\",\"dropoffStopId\":\"{{d}}\"}],\"expectedTotal\":150000,\"currency\":\"VND\",\"paymentChannel\":\"PAY_LATER\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["console.log('BOOK12 CREATE '+pm.response.text());pm.test('Initial idempotent booking created',()=>{pm.response.to.have.status(201);pm.environment.set('booking',pm.response.json().id)})"]}}]},{"name":"BOOK-12 Replay same key and exact body","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{t}}"},{"key":"Idempotency-Key","value":"pbl6-r3-book12-booking"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/bookings","body":{"mode":"raw","raw":"{\"holdToken\":\"{{hold}}\",\"contact\":{\"fullName\":\"PBL6 Idempotency Customer\",\"email\":\"seed.customer@example.test\",\"phone\":\"+840000000001\"},\"passengers\":[{\"seatId\":\"{{seat}}\",\"fullName\":\"PBL6 Idempotency Passenger\",\"pickupStopId\":\"{{p}}\",\"dropoffStopId\":\"{{d}}\"}],\"expectedTotal\":150000,\"currency\":\"VND\",\"paymentChannel\":\"PAY_LATER\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Same booking key and body replay the same resource',()=>{pm.response.to.have.status(201);pm.expect(pm.response.json().id).to.eql(pm.environment.get('booking'))})"]}}]},{"name":"BOOK-13 Reuse same key with different passenger","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{t}}"},{"key":"Idempotency-Key","value":"pbl6-r3-book12-booking"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/bookings","body":{"mode":"raw","raw":"{\"holdToken\":\"{{hold}}\",\"contact\":{\"fullName\":\"PBL6 Idempotency Customer\",\"email\":\"seed.customer@example.test\",\"phone\":\"+840000000001\"},\"passengers\":[{\"seatId\":\"{{seat}}\",\"fullName\":\"DIFFERENT PASSENGER\",\"pickupStopId\":\"{{p}}\",\"dropoffStopId\":\"{{d}}\"}],\"expectedTotal\":150000,\"currency\":\"VND\",\"paymentChannel\":\"PAY_LATER\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["console.log('BOOK13 KEY CONFLICT '+pm.response.text());pm.test('Different body under same key conflicts',()=>{pm.response.to.have.status(409);pm.expect(pm.response.json().error.code).to.eql('IDEMPOTENCY_CONFLICT')})"]}}]},{"name":"Read ticket for synthetic booking","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{t}}"}],"url":"http://localhost:5080/api/v1/tickets"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Ticket found for cleanup',()=>{pm.response.to.have.status(200);const b=pm.response.json();const t=b.items.find(x=>x.bookingId===pm.environment.get('booking'));pm.expect(t).to.exist;pm.environment.set('ticket',t.id)})"]}}]},{"name":"Read booking version for cleanup","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{t}}"}],"url":"http://localhost:5080/api/v1/bookings/{{booking}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.response.to.have.status(200);pm.environment.set('version',pm.response.json().rowVersion)"]}}]},{"name":"Preview synthetic cancellation for cleanup","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{t}}"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/bookings/{{booking}}/cancellation-preview","body":{"mode":"raw","raw":"{\"ticketIds\":[\"{{ticket}}\"]}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["console.log('BOOK12 CLEANUP PREVIEW '+pm.response.text());pm.response.to.have.status(200);pm.environment.set('preview',pm.response.json().previewId)"]}}]},{"name":"Cancel idempotency fixture","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{t}}"},{"key":"Idempotency-Key","value":"pbl6-r3-book12-cleanup-cancel"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/bookings/{{booking}}/cancel","body":{"mode":"raw","raw":"{\"previewId\":\"{{preview}}\",\"reason\":\"Cleanup booking idempotency fixture\",\"expectedVersion\":{{version}}}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.response.to.have.status(202)"]}}]}]}
