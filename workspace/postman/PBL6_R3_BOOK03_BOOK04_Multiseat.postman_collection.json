{
  "info": {"name":"PBL6 Round 3 atomic multiseat hold","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "item": [
    {"name":"Operator login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/auth/login","body":{"mode":"raw","raw":"{\"identifier\":\"operator.seed@example.test\",\"password\":\"OperatorPass1\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.response.to.have.status(200);pm.environment.set('operatorToken',pm.response.json().accessToken);"]}}]},
    {"name":"Create isolated future draft","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{operatorToken}}"},{"key":"Idempotency-Key","value":"pbl6-r3-book03-create-trip-{{$guid}}"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/operator/trips","body":{"mode":"raw","raw":"{\"routeId\":\"01990a00-0000-7000-8000-000000000006\",\"busId\":\"01990a00-0000-7000-8000-000000000003\",\"driverId\":\"01990a00-0000-7000-8000-000000000035\",\"departureAt\":\"2027-01-15T06:00:00Z\",\"arrivalAt\":\"2027-01-15T10:00:00Z\",\"fare\":{\"amount\":150000,\"currency\":\"VND\"},\"policyVersion\":\"cancel-mvp-v1\",\"expectedVersion\":0}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["console.log('MULTISEAT TRIP '+pm.response.text());pm.test('Isolated draft created',()=>{pm.response.to.have.status(201);pm.environment.set('tripId',pm.response.json().id)});"]}}]},
    {"name":"Publish isolated trip","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{operatorToken}}"},{"key":"Idempotency-Key","value":"pbl6-r3-book03-publish-trip-{{$guid}}"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/operator/trips/{{tripId}}/publish","body":{"mode":"raw","raw":"{\"expectedVersion\":0}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.response.to.have.status(202);"]}}]},
    {"name":"Customer login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/auth/login","body":{"mode":"raw","raw":"{\"identifier\":\"seed.customer@example.test\",\"password\":\"CustomerPass1\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.response.to.have.status(200);pm.environment.set('customerToken',pm.response.json().accessToken);setTimeout(()=>{},1000);"]}}]},
    {"name":"Read new trip seats and stops","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{customerToken}}"}],"url":"http://localhost:5080/api/v1/trips/{{tripId}}/seats"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["let s=[];if(pm.response.code===200){s=pm.response.json().seats.filter(x=>x.status==='AVAILABLE')}const a=Number(pm.collectionVariables.get('projectionAttempt')||0);if(s.length<2&&a<20){pm.collectionVariables.set('projectionAttempt',a+1);pm.execution.setNextRequest(pm.info.requestName);setTimeout(()=>{},500)}else{pm.collectionVariables.unset('projectionAttempt');pm.test('Select two available seats from the live response',()=>{pm.response.to.have.status(200);pm.expect(s.length).to.be.at.least(2)});if(s.length>=2){pm.environment.set('seatA',s[0].id);pm.environment.set('seatB',s[1].id)}}pm.environment.set('pickupId','01990a00-0000-7000-8000-000000000004');pm.environment.set('dropoffId','01990a00-0000-7000-8000-000000000005');"]}}]},
    {"name":"BOOK-03 Atomically hold two seats","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{customerToken}}"},{"key":"Idempotency-Key","value":"pbl6-r3-book03-two-seat-hold-{{$guid}}"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/trips/{{tripId}}/seat-holds","body":{"mode":"raw","raw":"{\"seatIds\":[\"{{seatA}}\",\"{{seatB}}\"],\"pickupStopId\":\"{{pickupId}}\",\"dropoffStopId\":\"{{dropoffId}}\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["console.log('MULTISEAT HOLD '+pm.response.text());pm.test('Two-seat hold succeeds atomically',()=>{pm.response.to.have.status(201);const b=pm.response.json();pm.expect(b.seats).to.have.length(2);pm.environment.set('holdToken',b.holdToken)});"]}}]},
    {"name":"BOOK-04 Reject multi-seat hold containing unknown seat","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{customerToken}}"},{"key":"Idempotency-Key","value":"pbl6-r3-book04-one-invalid-seat-{{$guid}}"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/trips/{{tripId}}/seat-holds","body":{"mode":"raw","raw":"{\"seatIds\":[\"{{seatA}}\",\"00000000-0000-7000-8000-000000000099\"],\"pickupStopId\":\"{{pickupId}}\",\"dropoffStopId\":\"{{dropoffId}}\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["console.log('PARTIAL HOLD '+pm.response.text());pm.test('Mixed valid and unknown seats are rejected',()=>pm.expect(pm.response.code).to.be.within(400,499));"]}}]},
    {"name":"Release successful synthetic hold","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{customerToken}}"},{"key":"Idempotency-Key","value":"pbl6-r3-book03-release-{{$guid}}"}],"url":"http://localhost:5080/api/v1/seat-holds/{{holdToken}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Successful synthetic hold was released',()=>pm.response.to.have.status(204));"]}}]}
  ]
}
