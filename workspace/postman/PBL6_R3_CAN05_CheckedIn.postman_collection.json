{
  "info": {"name":"PBL6 Round 3 checked-in ticket cancellation guard","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "item": [
    {"name":"Customer login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/auth/login","body":{"mode":"raw","raw":"{\"identifier\":\"seed.customer@example.test\",\"password\":\"CustomerPass1\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.response.to.have.status(200);pm.environment.set('t',pm.response.json().accessToken);"]}}]},
    {"name":"Read synthetic paid booking version","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{t}}"}],"url":"http://localhost:5080/api/v1/bookings/01a18263-9bb1-7393-9355-47d8efecdb8b"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.response.to.have.status(200);pm.environment.set('bookingVersion',pm.response.json().rowVersion);"]}}]},
    {"name":"CAN-01 Preview cancellation for checked-in ticket","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{t}}"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/bookings/01a18263-9bb1-7393-9355-47d8efecdb8b/cancellation-preview","body":{"mode":"raw","raw":"{\"ticketIds\":[\"01a18264-d050-7859-87c9-ac97499370e4\"]}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["console.log('CANCEL PREVIEW '+pm.response.text());pm.test('Cancellation preview response is readable',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json()).to.have.property('previewId');pm.environment.set('previewId',pm.response.json().previewId)});"]}}]},
    {"name":"CAN-05 Checked-in ticket cancellation is rejected","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{t}}"},{"key":"Idempotency-Key","value":"pbl6-r3-cancel-checked-in-ticket"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/bookings/01a18263-9bb1-7393-9355-47d8efecdb8b/cancel","body":{"mode":"raw","raw":"{\"previewId\":\"{{previewId}}\",\"reason\":\"Postman test ineligible checked-in ticket\",\"expectedVersion\":{{bookingVersion}}}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["console.log('CANCEL CHECKIN '+pm.response.text());pm.test('Checked-in ticket cannot be cancelled',()=>pm.expect(pm.response.code).to.be.within(400,499));"]}}]}
  ]
}
