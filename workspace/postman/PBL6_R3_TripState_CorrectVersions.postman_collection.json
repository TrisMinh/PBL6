{
  "info": {
    "name": "PBL6 Round 3 Trip state machine correct versions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Operator login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:5080/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"identifier\":\"operator.seed@example.test\",\"password\":\"OperatorPass1\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);pm.environment.set('accessToken',pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "TRIP-07 transition to BOARDING",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "pbl6-r3-trip-transition-boarding"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:5080/api/v1/operator/trips/01a1825e-ce81-77ac-a288-7ec225093288/status-transitions",
        "body": {
          "mode": "raw",
          "raw": "{\"expectedVersion\":1,\"targetStatus\":\"BOARDING\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Transition to BOARDING succeeds',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().status).to.eql('BOARDING')});"
            ]
          }
        }
      ]
    },
