{"info":{"name":"PBL6 Round 3 cancellation preview on already cancelled booking","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"name":"Customer login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/auth/login","body":{"mode":"raw","raw":"{\"identifier\":\"seed.customer@example.test\",\"password\":\"CustomerPass1\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.response.to.have.status(200);pm.environment.set('t',pm.response.json().accessToken)"]}}]},{"name":"CAN-06 Preview re-cancellation of already cancelled synthetic ticket","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{t}}"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/bookings/01a18280-06bd-743b-a9a8-5ed48b0790c9/cancellation-preview","body":{"mode":"raw","raw":"{\"ticketIds\":[\"01a18280-06e6-714b-bbb1-91433963f710\"]}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["console.log('REPEAT CANCEL PREVIEW '+pm.response.text());pm.test('Already cancelled ticket cannot be previewed for another cancellation',()=>pm.expect(pm.response.code).to.be.within(400,499));"]}}]}]}
