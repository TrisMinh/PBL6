    {
      "name": "SEC-05 SQL-like fullName registration",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "pbl6-r3-injection-sql"
          }
        ],
        "url": "http://localhost:5080/api/v1/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"fullName\":\"' OR 1=1--\",\"email\":\"pbl6.r3.sql@example.test\",\"phone\":\"+849010009991\",\"password\":\"CorrectHorse1\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('SQL-like text does not cause server error or leak internals',()=>{pm.expect(pm.response.code).not.to.eql(500);const t=pm.response.text().toLowerCase();pm.expect(t).not.to.include('sql exception');pm.expect(t).not.to.include('stack trace')});"
            ]
          }
        }
      ]
    },
