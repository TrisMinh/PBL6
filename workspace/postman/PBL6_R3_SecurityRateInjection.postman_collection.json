{
  "info": {
    "name": "PBL6 Round 3 Rate limit and input safety probes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "SEC-04 resend burst 1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "pbl6-r3-rate-resend-1"
          }
        ],
        "url": "http://localhost:5080/api/v1/auth/resend-verification",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"pbl6.r3.nonexistent-rate@example.test\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Resend burst response 1',()=>{if(1===7){pm.expect(pm.response.code).to.eql(429);pm.expect(pm.response.headers.get('Retry-After')).to.exist}else pm.expect(pm.response.code).to.be.oneOf([200,202,429])});"
            ]
          }
        }
      ]
    },
