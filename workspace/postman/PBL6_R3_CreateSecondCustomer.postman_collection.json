{"info":{"name":"PBL6 Round 3 create and verify second synthetic customer","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"name":"AUTH-01 Register second synthetic customer","request":{"method":"POST","header":[{"key":"Idempotency-Key","value":"pbl6-r3-second-customer-register"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/auth/register","body":{"mode":"raw","raw":"{\"fullName\":\"PBL6 Round 3 Customer Two\",\"email\":\"pbl6.r3.customer.two@example.test\",\"phone\":\"+849000000099\",\"password\":\"CorrectHorse1\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Second customer registration accepted',()=>pm.expect(pm.response.code).to.be.oneOf([201,202]))"]}}]},{"name":"Locate second customer verification email","request":{"method":"GET","header":[],"url":"http://localhost:8025/api/v1/messages"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Second customer verification email delivered',()=>{pm.response.to.have.status(200);const m=pm.response.json().messages.find(x=>x.To.some(y=>y.Address==='pbl6.r3.customer.two@example.test')&&x.Subject==='Verify your email');pm.expect(m).to.exist;pm.environment.set('m2',m.ID)})"]}}]},{"name":"Extract actual second customer OTP from Mailpit","request":{"method":"GET","header":[],"url":"http://localhost:8025/api/v1/message/{{m2}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Actual OTP and challenge extracted from Mailpit',()=>{pm.response.to.have.status(200);const t=pm.response.json().Text;const id=t.match(/challengeId=([0-9a-f-]+)/i);const code=t.match(/code=([0-9]{6})/i);pm.expect(id).to.exist;pm.expect(code).to.exist;pm.environment.set('c2',id[1]);pm.environment.set('otp2',code[1])})"]}}]},{"name":"Verify second customer","request":{"method":"POST","header":[{"key":"Idempotency-Key","value":"pbl6-r3-second-customer-verify"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/auth/verify","body":{"mode":"raw","raw":"{\"challengeId\":\"{{c2}}\",\"code\":\"{{otp2}}\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Second synthetic customer verifies and receives access token',()=>{pm.response.to.have.status(200);pm.environment.set('token2',pm.response.json().accessToken)})"]}}]},{"name":"Login second customer","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/auth/login","body":{"mode":"raw","raw":"{\"identifier\":\"pbl6.r3.customer.two@example.test\",\"password\":\"CorrectHorse1\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Second synthetic customer can log in',()=>pm.response.to.have.status(200))"]}}]}]}
