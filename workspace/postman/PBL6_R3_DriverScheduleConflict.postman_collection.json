{
  "info": {
    "name": "PBL6 Round 3 Driver schedule conflict",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Operator login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:5080/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"identifier\":\"operator.seed@example.test\",\"password\":\"OperatorPass1\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);pm.environment.set('t',pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create a second synthetic bus for driver overlap probe",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{t}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "pbl6-r3-create-bus-002"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:5080/api/v1/operator/buses",
        "body": {
          "mode": "raw",
          "raw": "{\"plateNumber\":\"PBL6-R3-TEST-002\",\"type\":\"Test Coach\",\"amenities\":[\"AC\"],\"expectedVersion\":0}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Second synthetic bus created',()=>{pm.response.to.have.status(201);pm.environment.set('bus2',pm.response.json().id)});"
            ]
          }
        }
      ]
    },
    {
      "name": "TRIP-05 Draft overlapping same driver on another bus",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{t}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "pbl6-r3-driver-overlap-draft-002"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:5080/api/v1/operator/trips",
        "body": {
          "mode": "raw",
          "raw": "{\"routeId\":\"01990a00-0000-7000-8000-000000000006\",\"busId\":\"{{bus2}}\",\"driverId\":\"01990a00-0000-7000-8000-000000000035\",\"departureAt\":\"2026-12-05T06:30:00Z\",\"arrivalAt\":\"2026-12-05T10:30:00Z\",\"fare\":{\"amount\":150000,\"currency\":\"VND\"},\"policyVersion\":\"cancel-mvp-v1\",\"expectedVersion\":0}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Driver-overlap draft created for publish validation',()=>{pm.response.to.have.status(201);pm.environment.set('overlapDriverTrip',pm.response.json().id)});"
            ]
          }
        }
      ]
    },
    {
      "name": "TRIP-05 Reject overlapping driver at publish",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{t}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "pbl6-r3-driver-overlap-publish-002"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:5080/api/v1/operator/trips/{{overlapDriverTrip}}/publish",
        "body": {
          "mode": "raw",
          "raw": "{\"expectedVersion\":0}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Same driver overlap returns SCHEDULE_CONFLICT',()=>{pm.response.to.have.status(409);pm.expect(pm.response.json().error.code).to.eql('SCHEDULE_CONFLICT')});"
            ]
          }
        }
      ]
    },
    {
      "name": "Deactivate synthetic overlap bus",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{t}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "pbl6-r3-deactivate-bus-002"
          }
        ],
        "url": "http://localhost:5080/api/v1/operator/buses/{{bus2}}/deactivate"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Overlap probe bus deactivated',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}