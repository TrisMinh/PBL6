{"info":{"name":"PBL6 Round 3 PAY_LATER booking when enabled","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"name":"Customer login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/auth/login","body":{"mode":"raw","raw":"{\"identifier\":\"seed.customer@example.test\",\"password\":\"CustomerPass1\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.response.to.have.status(200);pm.environment.set('t',pm.response.json().accessToken)"]}}]},{"name":"Read seats on active synthetic trip","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{t}}"}],"url":"http://localhost:5080/api/v1/trips/01990a00-0000-7000-8000-000000000007/seats"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["console.log('PAYLATER SEATS '+pm.response.text());pm.test('Available seat found',()=>{pm.response.to.have.status(200);const s=pm.response.json().seats.find(x=>x.status==='AVAILABLE');pm.expect(s).to.exist;pm.environment.set('seat',s.id)});pm.environment.set('p','01990a00-0000-7000-8000-000000000004');pm.environment.set('d','01990a00-0000-7000-8000-000000000005')"]}}]},{"name":"Hold one seat","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{t}}"},{"key":"Idempotency-Key","value":"pbl6-r3-book18-hold"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/trips/01990a00-0000-7000-8000-000000000007/seat-holds","body":{"mode":"raw","raw":"{\"seatIds\":[\"{{seat}}\"],\"pickupStopId\":\"{{p}}\",\"dropoffStopId\":\"{{d}}\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["console.log('PAYLATER HOLD '+pm.response.text());pm.response.to.have.status(201);pm.environment.set('h',pm.response.json().holdToken)"]}}]},{"name":"BOOK-18 Create PAY_LATER booking on enabled operator","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{t}}"},{"key":"Idempotency-Key","value":"pbl6-r3-book18-booking"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/bookings","body":{"mode":"raw","raw":"{\"holdToken\":\"{{h}}\",\"contact\":{\"fullName\":\"PBL6 Round 3 PayLater Test\",\"email\":\"seed.customer@example.test\",\"phone\":\"+840000000001\"},\"passengers\":[{\"seatId\":\"{{seat}}\",\"fullName\":\"PBL6 Round 3 PayLater Passenger\",\"pickupStopId\":\"{{p}}\",\"dropoffStopId\":\"{{d}}\"}],\"expectedTotal\":150000,\"currency\":\"VND\",\"paymentChannel\":\"PAY_LATER\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["console.log('PAYLATER BOOKING '+pm.response.text());pm.test('PAY_LATER booking accepted for enabled operator',()=>{pm.expect([201,202]).to.include(pm.response.code);pm.expect(pm.response.json().paymentChannel).to.eql('PAY_LATER');pm.environment.set('booking',pm.response.json().id)})"]}}]}]}
