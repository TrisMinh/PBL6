{
  "info": {
    "name": "PBL6 Round 3 auth challenge expiry",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Locate expired challenge email",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:8025/api/v1/messages"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Locate staged verification email',()=>{pm.response.to.have.status(200);const m=pm.response.json().messages.find(x=>x.To.some(y=>y.Address==='pbl6.r3.expiry@example.test')&&x.Subject==='Verify your email');pm.expect(m).to.exist;pm.environment.set('expiredMessageId',m.ID)});"
            ]
          }
        }
      ]
    },
    {
      "name": "Read code issued for staged challenge",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:8025/api/v1/message/{{expiredMessageId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Extract actual challenge and OTP from Mailpit',()=>{pm.response.to.have.status(200);const t=pm.response.json().Text;const id=t.match(/challengeId=([0-9a-f-]+)/i);const code=t.match(/code=([0-9]{6})/i);pm.expect(id).to.exist;pm.expect(code).to.exist;pm.environment.set('expiredChallengeId',id[1]);pm.environment.set('expiredChallengeCode',code[1])});"
            ]
          }
        }
      ]
    },
    {
      "name": "AUTH-06 Submit correct code after expiry",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "pbl6-r3-expired-challenge-verify"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:5080/api/v1/auth/verify",
        "body": {
          "mode": "raw",
          "raw": "{\"challengeId\":\"{{expiredChallengeId}}\",\"code\":\"{{expiredChallengeCode}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('EXPIRED OTP '+pm.response.text());pm.test('Expired challenge rejected',()=>{pm.response.to.have.status(410);pm.expect(pm.response.json().error.code).to.eql('VERIFICATION_EXPIRED')});"
            ]
          }
        }
      ]
    },
    {
      "name": "Expired unverified account cannot login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:5080/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"identifier\":\"pbl6.r3.expiry@example.test\",\"password\":\"CorrectHorse1\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unverified expired account receives no session',()=>{pm.expect([401,423]).to.include(pm.response.code);pm.expect(pm.response.json().accessToken).to.be.undefined});"
            ]
          }
        }
      ]
    }
  ]
}