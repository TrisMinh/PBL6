    {
      "name": "SEC-03 tampered token rejected",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tamperedToken}}"
          }
        ],
        "url": "{{baseUrl}}/users/me"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const p=pm.environment.get('customerToken').split('.'); p[1]=Buffer.from(JSON.stringify({sub:'00000000-0000-7000-8000-000000000001',role:'PLATFORM_ADMIN'})).toString('base64url'); pm.environment.set('tamperedToken',p.join('.'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Modified JWT signature is rejected',()=>{pm.response.to.have.status(401)});"
            ]
          }
        }
      ]
    },
