      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Customer cannot access admin user list',()=>{pm.response.to.have.status(403);pm.expect(pm.response.json().error.code).to.eql('ACCESS_DENIED')});"
