            "type": "text/javascript",
            "exec": [
              "const c=pm.environment.get('otpCode');pm.request.body.update(JSON.stringify({challengeId:pm.environment.get('otpChallengeId'),code:c==='000000'?'111111':'000000'}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Wrong OTP is rejected',()=>{pm.expect(pm.response.code).to.be.within(400,499);pm.expect(pm.response.json().error).to.have.property('code')});"
            ]
          }
