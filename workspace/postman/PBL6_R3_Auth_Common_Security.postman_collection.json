    {
      "name": "Login platform admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"identifier\": \"admin.seed@example.test\", \"password\": \"AdminPass1234\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin login succeeds',()=>{pm.response.to.have.status(200);pm.environment.set('adminToken',pm.response.json().accessToken)});"
            ]
          }
        }
      ]
    },
