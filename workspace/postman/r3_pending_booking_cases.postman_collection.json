    {
      "name": "BOOK-04 Customer 1 multiseat attempt is all-or-nothing",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{r3c1}}"
          },
          {
            "key": "Idempotency-Key",
