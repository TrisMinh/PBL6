    {
      "name": "BOOK-01 Read trip seats and statuses",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{r3c1}}"
          }
        ],
        "url": "http://localhost:5080/api/v1/trips/01990a00-0000-7000-8000-000000000007/seats"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
            "pm.test('Seat list includes status, reference price, and freshness timestamp',()=>{pm.response.to.have.status(200);const b=pm.response.json();pm.expect(b.seats.length).to.be.above(0);pm.expect(b.availabilityAsOf).to.be.a('string').and.not.empty;pm.expect(b.serverTime).to.be.a('string').and.not.empty;const states=[...new Set(b.seats.map(x=>x.status))];pm.expect(states).to.include('AVAILABLE');pm.expect(states).to.include('BOOKED');pm.expect(b.seats.every(x=>['AVAILABLE','HELD','BOOKED','DISABLED'].includes(x.status))).to.eql(true);pm.expect(b.seats.every(x=>Number.isInteger(x.price.amount)&&x.price.currency==='VND')).to.eql(true);pm.environment.set('r3seatA','01990a00-0000-7000-8000-000000000043');pm.environment.set('r3seatB','01990a00-0000-7000-8000-000000000044');});"
            ]
          }
        }
      ]
    },
    {
      "name": "BOOK-02 Create one-seat hold",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{r3c1}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "r3-book02-one-seat-{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:5080/api/v1/trips/01990a00-0000-7000-8000-000000000007/seat-holds",
        "body": {
          "mode": "raw",
          "raw": "{\"seatIds\":[\"01990a00-0000-7000-8000-000000000043\"],\"pickupStopId\":\"01990a00-0000-7000-8000-000000000004\",\"dropoffStopId\":\"01990a00-0000-7000-8000-000000000005\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('BOOK02 response '+pm.response.text());pm.test('One seat hold returns token, expiry, seat price and policy snapshot',()=>{pm.response.to.have.status(201);const b=pm.response.json();pm.expect(b.holdToken).to.be.a('string').and.not.empty;pm.expect(b.expiresAt).to.be.a('string');pm.expect(b.seats).to.have.length(1);pm.expect(b.seats[0].price).to.exist;pm.expect(b.policySnapshot).to.be.an('object');pm.expect(b.policySnapshot.policyVersion).to.be.a('string').and.not.empty;pm.expect(b.policySnapshot).to.have.property('allowPayLater');pm.environment.set('r3hold02',b.holdToken);});if(pm.response.code===201)pm.environment.set('r3hold02',pm.response.json().holdToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Release BOOK-02 test hold",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{r3c1}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "r3-book02-release-{{$guid}}"
          }
        ],
        "url": "http://localhost:5080/api/v1/seat-holds/{{r3hold02}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('BOOK-02 hold cleaned up',()=>pm.expect(pm.response.code).to.be.oneOf([204,404]));"
            ]
          }
        }
      ]
    },
    {
      "name": "BOOK-03 Hold multiple seats",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{r3c1}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "r3-book03-multiseat-{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:5080/api/v1/trips/01990a00-0000-7000-8000-000000000007/seat-holds",
        "body": {
          "mode": "raw",
          "raw": "{\"seatIds\":[\"01990a00-0000-7000-8000-000000000043\",\"01990a00-0000-7000-8000-000000000044\"],\"pickupStopId\":\"01990a00-0000-7000-8000-000000000004\",\"dropoffStopId\":\"01990a00-0000-7000-8000-000000000005\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Both seats held atomically with one hold token',()=>{pm.response.to.have.status(201);const b=pm.response.json();pm.expect(b.holdToken).to.be.a('string');pm.expect(b.seats).to.have.length(2);pm.expect(b.seats.every(x=>x.status==='HELD')).to.eql(true);pm.environment.set('r3hold03',b.holdToken);});"
            ]
          }
        }
      ]
    },
    {
      "name": "Release BOOK-03 test hold",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{r3c1}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "r3-book03-release-{{$guid}}"
          }
        ],
        "url": "http://localhost:5080/api/v1/seat-holds/{{r3hold03}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('BOOK-03 test hold cleaned up',()=>pm.response.to.have.status(204));"
            ]
