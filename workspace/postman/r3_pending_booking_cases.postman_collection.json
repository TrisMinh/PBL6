        ],
        "url": "http://localhost:5080/api/v1/trips/01990a00-0000-7000-8000-000000000007/seat-holds",
        "body": {
          "mode": "raw",
          "raw": "{\"seatIds\":[\"01990a00-0000-7000-8000-000000000044\",\"01990a00-0000-7000-8000-000000000043\"],\"pickupStopId\":\"01990a00-0000-7000-8000-000000000004\",\"dropoffStopId\":\"01990a00-0000-7000-8000-000000000005\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
            "pm.test('Conflict returns affected held seat code',()=>{pm.response.to.have.status(409);const e=pm.response.json().error;pm.expect(e.code).to.eql('SEAT_UNAVAILABLE');pm.expect(e.details.affectedSeatCodes).to.include('2A');});"
            ]
          }
        }
      ]
    },
    {
      "name": "BOOK-04 Verify available seat was not partially held",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{r3c1}}"
          }
        ],
        "url": "http://localhost:5080/api/v1/trips/01990a00-0000-7000-8000-000000000007/seats"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('All-or-nothing preserved seat B',()=>{pm.response.to.have.status(200);const x=pm.response.json().seats.find(s=>s.id===pm.environment.get('r3seatB'));pm.expect(x.status).to.eql('AVAILABLE');});"
            ]
          }
        }
      ]
    },
