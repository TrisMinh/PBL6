    },
    {
      "name": "BOOK-05 Concurrent requests from two customers",
      "request": {
        "method": "GET",
        "url": "http://localhost:5080/ready"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const url='http://localhost:5080/api/v1/trips/01990a00-0000-7000-8000-000000000007/seat-holds';const body=JSON.stringify({seatIds:['01990a00-0000-7000-8000-000000000043'],pickupStopId:'01990a00-0000-7000-8000-000000000004',dropoffStopId:'01990a00-0000-7000-8000-000000000005'});const headers=(t,k)=>({'Authorization':'Bearer '+t,'Idempotency-Key':k,'Content-Type':'application/json'});let result=[];const done=(err,res)=>{result.push({err:!!err,code:res&&res.code,body:res&&res.json()});if(result.length===2){pm.test('Concurrent seat hold: exactly one winner and one conflict',()=>{pm.expect(result.every(x=>!x.err)).to.eql(true);pm.expect(result.map(x=>x.code).sort()).to.eql([201,409]);});const win=result.find(x=>x.code===201);if(win&&win.body&&win.body.holdToken){pm.sendRequest({url:'http://localhost:5080/api/v1/seat-holds/'+win.body.holdToken,method:'DELETE',header:headers(pm.environment.get('r3c1'),'r3-book05-cleanup-'+Date.now())},(e,r)=>console.log('race cleanup',e&&e.message,r&&r.code));}}};pm.sendRequest({url,method:'POST',header:headers(pm.environment.get('r3c1'),'r3-book05-c1-fix1-'+Date.now()),body:{mode:'raw',raw:body}},done);pm.sendRequest({url,method:'POST',header:headers(pm.environment.get('r3c2'),'r3-book05-c2-fix1-'+Date.now()),body:{mode:'raw',raw:body}},done);"
            ]
          }
        }
      ]
    },
