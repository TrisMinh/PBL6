  "item": [
    {
      "name": "Login Customer 1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:5080/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"identifier\":\"seed.customer@example.test\",\"password\":\"CustomerPass1\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Customer 1 login',()=>pm.response.to.have.status(200));pm.environment.set('r3c1',pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login Customer 2",
