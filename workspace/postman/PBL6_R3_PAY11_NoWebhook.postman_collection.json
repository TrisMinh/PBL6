{"info":{"name":"PBL6 Round 3 payment intent without webhook","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"name":"Customer login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/auth/login","body":{"mode":"raw","raw":"{\"identifier\":\"seed.customer@example.test\",\"password\":\"CustomerPass1\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.response.to.have.status(200);pm.environment.set('t',pm.response.json().accessToken)"]}}]},{"name":"Read available seat","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{t}}"}],"url":"http://localhost:5080/api/v1/trips/01a1825e-ce81-77ac-a288-7ec225093288/seats"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Seat available for no-webhook scenario',()=>{pm.response.to.have.status(200);const s=pm.response.json().seats.find(x=>x.status==='AVAILABLE');pm.expect(s).to.exist;pm.environment.set('seat',s.id)});pm.environment.set('p','01990a00-0000-7000-8000-000000000004');pm.environment.set('d','01990a00-0000-7000-8000-000000000005')"]}}]},{"name":"Hold test seat","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{t}}"},{"key":"Idempotency-Key","value":"pbl6-r3-pay11-hold"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/trips/01a1825e-ce81-77ac-a288-7ec225093288/seat-holds","body":{"mode":"raw","raw":"{\"seatIds\":[\"{{seat}}\"],\"pickupStopId\":\"{{p}}\",\"dropoffStopId\":\"{{d}}\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.response.to.have.status(201);pm.environment.set('h',pm.response.json().holdToken)"]}}]},{"name":"Create pending PREPAID booking","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{t}}"},{"key":"Idempotency-Key","value":"pbl6-r3-pay11-booking"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/bookings","body":{"mode":"raw","raw":"{\"holdToken\":\"{{h}}\",\"contact\":{\"fullName\":\"PBL6 No Webhook Test\",\"email\":\"seed.customer@example.test\",\"phone\":\"+840000000001\"},\"passengers\":[{\"seatId\":\"{{seat}}\",\"fullName\":\"PBL6 No Webhook Passenger\",\"pickupStopId\":\"{{p}}\",\"dropoffStopId\":\"{{d}}\"}],\"expectedTotal\":150000,\"currency\":\"VND\",\"paymentChannel\":\"PREPAID\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.response.to.have.status(201);pm.environment.set('booking',pm.response.json().id)"]}}]},{"name":"PAY-11 Create payment intent only, do not invoke gateway","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{t}}"},{"key":"Idempotency-Key","value":"pbl6-r3-pay11-payment"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/bookings/{{booking}}/payments","body":{"mode":"raw","raw":"{\"provider\":\"VNPAY_SANDBOX\",\"method\":\"VNPAY_QR\",\"returnUri\":\"http://localhost:5173/payment/result\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.response.to.have.status(201);pm.environment.set('payment',pm.response.json().id)"]}}]},{"name":"Read payment before any webhook","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{t}}"}],"url":"http://localhost:5080/api/v1/payments/{{payment}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["console.log('PAY11 PAYMENT '+pm.response.text());pm.test('Payment remains pending without gateway callback',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().status).to.be.oneOf(['PENDING','PROCESSING'])})"]}}]},{"name":"Read booking before any webhook","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{t}}"}],"url":"http://localhost:5080/api/v1/bookings/{{booking}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["console.log('PAY11 BOOKING '+pm.response.text());pm.test('Booking is not paid before webhook',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().status).to.eql('PENDING_PAYMENT')})"]}}]}]}
