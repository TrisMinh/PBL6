{
    "info":  {
                 "name":  "PBL6 Round 3 atomic multiseat hold on available synthetic trip",
                 "schema":  "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
             },
    "item":  [
                 {
                     "name":  "Customer login",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "http://localhost:5080/api/v1/auth/login",
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\"identifier\":\"seed.customer@example.test\",\"password\":\"CustomerPass1\"}"
                                              }
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "pm.response.to.have.status(200);pm.environment.set(\u0027t\u0027,pm.response.json().accessToken)"
                                                               ]
                                                  }
                                   }
                               ]
                 },
                 {
                     "name":  "Read live seats",
                     "request":  {
                                     "method":  "GET",
                                     "header":  [
                                                    {
                                                        "key":  "Authorization",
                                                        "value":  "Bearer {{t}}"
                                                    }
                                                ],
                                     "url":  "http://localhost:5080/api/v1/trips/01990a00-0000-7000-8000-000000000007/seats"
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "pm.test(\u0027Two available seats exist\u0027,()=\u003e{pm.response.to.have.status(200);const s=pm.response.json().seats.filter(x=\u003ex.status===\u0027AVAILABLE\u0027);pm.expect(s.length).to.be.at.least(2);pm.environment.set(\u0027a\u0027,s[0].id);pm.environment.set(\u0027b\u0027,s[1].id)});pm.environment.set(\u0027p\u0027,\u002701990a00-0000-7000-8000-000000000004\u0027);pm.environment.set(\u0027d\u0027,\u002701990a00-0000-7000-8000-000000000005\u0027)"
                                                               ]
                                                  }
                                   }
                               ]
                 },
                 {
                     "name":  "BOOK-04 Invalid seat does not partially hold valid seat",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Authorization",
                                                        "value":  "Bearer {{t}}"
                                                    },
                                                    {
                                                        "key":  "Idempotency-Key",
                                                        "value":  "pbl6-r3-book04-existing-trip"
                                                    },
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "http://localhost:5080/api/v1/trips/01990a00-0000-7000-8000-000000000007/seat-holds",
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\"seatIds\":[\"{{a}}\",\"00000000-0000-7000-8000-000000000099\"],\"pickupStopId\":\"{{p}}\",\"dropoffStopId\":\"{{d}}\"}"
                                              }
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "pm.test(\u0027Mixed valid and unknown seat ids rejected\u0027,()=\u003epm.expect(pm.response.code).to.be.within(400,499));pm.environment.set(\u0027probeSeat\u0027,pm.environment.get(\u0027a\u0027))"
                                                               ]
                                                  }
                                   }
                               ]
                 },
                 {
                     "name":  "Verify the valid seat remained available",
                     "request":  {
                                     "method":  "GET",
                                     "header":  [
                                                    {
                                                        "key":  "Authorization",
                                                        "value":  "Bearer {{t}}"
                                                    }
                                                ],
                                     "url":  "http://localhost:5080/api/v1/trips/01990a00-0000-7000-8000-000000000007/seats"
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "pm.test(\u0027Invalid multi-seat request left no partial hold\u0027,()=\u003e{pm.response.to.have.status(200);const s=pm.response.json().seats.find(x=\u003ex.id===pm.environment.get(\u0027a\u0027));pm.expect(s.status).to.eql(\u0027AVAILABLE\u0027)})"
                                                               ]
                                                  }
                                   }
                               ]
                 },
                 {
                     "name":  "BOOK-03 Hold two available seats in one request",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Authorization",
                                                        "value":  "Bearer {{t}}"
                                                    },
                                                    {
                                                        "key":  "Idempotency-Key",
                                                        "value":  "pbl6-r3-book03-existing-trip"
                                                    },
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "http://localhost:5080/api/v1/trips/01990a00-0000-7000-8000-000000000007/seat-holds",
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\"seatIds\":[\"{{a}}\",\"{{b}}\"],\"pickupStopId\":\"{{p}}\",\"dropoffStopId\":\"{{d}}\"}"
                                              }
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "console.log(\u0027BOOK03 HOLD \u0027+pm.response.text());pm.test(\u0027Two seats held atomically\u0027,()=\u003e{pm.response.to.have.status(201);const b=pm.response.json();pm.expect(b.seats).to.have.length(2);pm.environment.set(\u0027hold\u0027,b.holdToken)})"
                                                               ]
                                                  }
                                   }
                               ]
                 },
                 {
                     "name":  "Release successful two-seat hold",
                     "request":  {
                                     "method":  "DELETE",
                                     "header":  [
                                                    {
                                                        "key":  "Authorization",
                                                        "value":  "Bearer {{t}}"
                                                    },
                                                    {
                                                        "key":  "Idempotency-Key",
                                                        "value":  "pbl6-r3-book03-release"
                                                    }
                                                ],
                                     "url":  "http://localhost:5080/api/v1/seat-holds/{{hold}}"
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "pm.test(\u0027Two-seat test hold released\u0027,()=\u003epm.response.to.have.status(204))"
                                                               ]
                                                  }
                                   }
                               ]
                 }
             ]
}
