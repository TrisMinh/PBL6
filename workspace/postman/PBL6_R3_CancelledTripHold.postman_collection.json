{
  "info": {
    "name": "PBL6 Round 3 hold against cancelled trip",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Customer login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:5080/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"identifier\":\"seed.customer@example.test\",\"password\":\"CustomerPass1\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);pm.environment.set('t',pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Read cancelled trip inventory if prepared",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{t}}"
          }
        ],
        "url": "http://localhost:5080/api/v1/trips/01a1826d-de88-7e82-b851-f44393cb9534/seats"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Cancelled synthetic trip inventory exists',()=>{pm.response.to.have.status(200);const s=pm.response.json().seats[0];pm.expect(s).to.exist;pm.environment.set('cancelSeat',s.id)});"
            ]
          }
        }
      ]
    },
    {
      "name": "BOOK-07 Hold on cancelled trip is rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{t}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "pbl6-r3-hold-cancelled-trip"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:5080/api/v1/trips/01a1826d-de88-7e82-b851-f44393cb9534/seat-holds",
        "body": {
          "mode": "raw",
          "raw": "{\"seatIds\":[\"{{cancelSeat}}\"],\"pickupStopId\":\"01990a00-0000-7000-8000-000000000004\",\"dropoffStopId\":\"01990a00-0000-7000-8000-000000000005\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('CANCEL HOLD '+pm.response.text());pm.test('Non-sellable trip is rejected',()=>{pm.response.to.have.status(409);pm.expect(pm.response.json().error.code).to.eql('TRIP_NOT_SELLABLE')});"
            ]
          }
        }
      ]
    }
  ]
}