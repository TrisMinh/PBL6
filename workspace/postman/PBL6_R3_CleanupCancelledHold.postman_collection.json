{
  "info": {
    "name": "PBL6 cleanup synthetic cancelled-trip hold",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Customer login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:5080/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"identifier\":\"seed.customer@example.test\",\"password\":\"CustomerPass1\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);pm.environment.set('t',pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Release unintended cancelled-trip hold",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{t}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "pbl6-r3-release-cancelled-trip-hold"
          }
        ],
        "url": "http://localhost:5080/api/v1/seat-holds/2WGtZZWVDnICto0m-GQRBrk9rW6R662tbxF3LBsoMKI"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Release synthetic hold created by failed business rule',()=>pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}