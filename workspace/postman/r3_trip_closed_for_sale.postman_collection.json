{
  "info": { "name": "PBL6 Round 3 BOOK-07 closed-for-sale trip", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "item": [
    {
      "name": "Login seeded customer",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "http://localhost:5080/api/v1/auth/login", "body": { "mode": "raw", "raw": "{\"identifier\":\"seed.customer@example.test\",\"password\":\"CustomerPass1\"}" } },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Seed customer login',()=>{pm.response.to.have.status(200);pm.environment.set('r3ClosedSaleToken',pm.response.json().accessToken);});"] } }]
    },
    {
      "name": "BOOK-07 Hold on trip closed for sale",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{r3ClosedSaleToken}}" }, { "key": "Idempotency-Key", "value": "r3-book07-closed-{{$guid}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "http://localhost:5080/api/v1/trips/01990a00-0000-7000-8000-000000000007/seat-holds", "body": { "mode": "raw", "raw": "{\"seatIds\":[\"01990a00-0000-7000-8000-000000000044\"],\"pickupStopId\":\"01990a00-0000-7000-8000-000000000004\",\"dropoffStopId\":\"01990a00-0000-7000-8000-000000000005\"}" } },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Closed-for-sale trip returns 409 TRIP_NOT_SELLABLE',()=>{pm.response.to.have.status(409);pm.expect(pm.response.json().error.code).to.eql('TRIP_NOT_SELLABLE');});"] } }]
    }
  ]
}
