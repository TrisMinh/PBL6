{"info":{"name":"PBL6 Round 3 foreign customer cannot use another customer's hold","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"name":"Owner customer login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/auth/login","body":{"mode":"raw","raw":"{\"identifier\":\"seed.customer@example.test\",\"password\":\"CustomerPass1\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.response.to.have.status(200);pm.environment.set('ownerToken',pm.response.json().accessToken)"]}}]},{"name":"Choose an available seat","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{ownerToken}}"}],"url":"http://localhost:5080/api/v1/trips/01990a00-0000-7000-8000-000000000007/seats"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('An available seat is present',()=>{pm.response.to.have.status(200);const s=pm.response.json().seats.find(x=>x.status==='AVAILABLE');pm.expect(s).to.exist;pm.environment.set('seat',s.id)});pm.environment.set('pickup','01990a00-0000-7000-8000-000000000004');pm.environment.set('dropoff','01990a00-0000-7000-8000-000000000005')"]}}]},{"name":"Owner creates a single-seat hold","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{ownerToken}}"},{"key":"Idempotency-Key","value":"pbl6-r3-book17-owner-hold"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/trips/01990a00-0000-7000-8000-000000000007/seat-holds","body":{"mode":"raw","raw":"{\"seatIds\":[\"{{seat}}\"],\"pickupStopId\":\"{{pickup}}\",\"dropoffStopId\":\"{{dropoff}}\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.response.to.have.status(201);pm.environment.set('holdToken',pm.response.json().holdToken)"]}}]},{"name":"Second customer login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/auth/login","body":{"mode":"raw","raw":"{\"identifier\":\"pbl6.r3.customer.two@example.test\",\"password\":\"CorrectHorse1\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.response.to.have.status(200);pm.environment.set('otherToken',pm.response.json().accessToken)"]}}]},{"name":"BOOK-17 Other customer cannot create booking from foreign hold","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{otherToken}}"},{"key":"Idempotency-Key","value":"pbl6-r3-book17-foreign-booking"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/bookings","body":{"mode":"raw","raw":"{\"holdToken\":\"{{holdToken}}\",\"contact\":{\"fullName\":\"PBL6 Round 3 Customer Two\",\"email\":\"pbl6.r3.customer.two@example.test\",\"phone\":\"+849000000099\"},\"passengers\":[{\"seatId\":\"{{seat}}\",\"fullName\":\"PBL6 Round 3 Customer Two\",\"pickupStopId\":\"{{pickup}}\",\"dropoffStopId\":\"{{dropoff}}\"}],\"expectedTotal\":150000,\"currency\":\"VND\",\"paymentChannel\":\"PREPAID\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["console.log('FOREIGN HOLD BOOKING '+pm.response.text());pm.test('Foreign hold cannot be used by another customer',()=>pm.expect([403,404]).to.include(pm.response.code));"]}}]},{"name":"Owner restores access token for cleanup","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/auth/login","body":{"mode":"raw","raw":"{\"identifier\":\"seed.customer@example.test\",\"password\":\"CustomerPass1\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.response.to.have.status(200);pm.environment.set('ownerToken',pm.response.json().accessToken)"]}}]},{"name":"Release owner hold","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{ownerToken}}"},{"key":"Idempotency-Key","value":"pbl6-r3-book17-release"}],"url":"http://localhost:5080/api/v1/seat-holds/{{holdToken}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Owner hold released after cross-customer check',()=>pm.response.to.have.status(204))"]}}]}]}
