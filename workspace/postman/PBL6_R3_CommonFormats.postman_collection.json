{
  "info": {
    "name": "PBL6 Round 3 common time and money formats",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Customer login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:5080/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"identifier\":\"seed.customer@example.test\",\"password\":\"CustomerPass1\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);pm.environment.set('t',pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "CMN-05 Trip date and VND money format",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:5080/api/v1/trips/01a1825d-b562-7b04-bab7-d50af84b5142"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Trip uses timezone-aware ISO timestamp and integer VND amount',()=>{pm.response.to.have.status(200);const x=pm.response.json();pm.expect(x.departureAt).to.match(/(Z|[+-]\\d{2}:\\d{2})$/);pm.expect(x.arrivalAt).to.match(/(Z|[+-]\\d{2}:\\d{2})$/);pm.expect(Number.isInteger(x.fare.amount)).to.eql(true);pm.expect(x.fare.currency).to.eql('VND')});"
            ]
          }
        }
      ]
    },
    {
      "name": "CMN-05 Payment VND amount format",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{t}}"
          }
        ],
        "url": "http://localhost:5080/api/v1/payments/01a18263-e1eb-72e0-bf3f-21eb7d42c212"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Payment amount is integer VND and status timestamp model is safe',()=>{pm.response.to.have.status(200);const x=pm.response.json();pm.expect(Number.isInteger(x.amount)).to.eql(true);pm.expect(x.currency).to.eql('VND')});"
            ]
          }
        }
      ]
    }
  ]
}