{
  "info": {
    "name": "PBL6 Round 3 trip validation and idempotent cancel",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Operator login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:5080/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"identifier\":\"operator.seed@example.test\",\"password\":\"OperatorPass1\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);pm.environment.set('t',pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "TRIP-03 Reject trip missing driver",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{t}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "pbl6-r3-missing-driver-trip"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:5080/api/v1/operator/trips",
        "body": {
          "mode": "raw",
          "raw": "{\"routeId\":\"01990a00-0000-7000-8000-000000000006\",\"busId\":\"01990a00-0000-7000-8000-000000000003\",\"driverId\":\"00000000-0000-0000-0000-000000000000\",\"departureAt\":\"2026-12-10T06:00:00Z\",\"arrivalAt\":\"2026-12-10T10:00:00Z\",\"fare\":{\"amount\":150000,\"currency\":\"VND\"},\"policyVersion\":\"cancel-mvp-v1\",\"expectedVersion\":0}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Trip without usable driver rejected',()=>pm.expect([400,422]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create future trip for idempotent cancellation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{t}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "pbl6-r3-trip-cancel-fixture"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:5080/api/v1/operator/trips",
        "body": {
          "mode": "raw",
          "raw": "{\"routeId\":\"01990a00-0000-7000-8000-000000000006\",\"busId\":\"01990a00-0000-7000-8000-000000000003\",\"driverId\":\"01990a00-0000-7000-8000-000000000035\",\"departureAt\":\"2026-12-11T06:00:00Z\",\"arrivalAt\":\"2026-12-11T10:00:00Z\",\"fare\":{\"amount\":150000,\"currency\":\"VND\"},\"policyVersion\":\"cancel-mvp-v1\",\"expectedVersion\":0}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Cancellation fixture draft created',()=>{pm.response.to.have.status(201);pm.environment.set('cancelTripId',pm.response.json().id)});"
            ]
          }
        }
      ]
    },
    {
      "name": "Publish cancellation fixture",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{t}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "pbl6-r3-trip-cancel-publish"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:5080/api/v1/operator/trips/{{cancelTripId}}/publish",
        "body": {
          "mode": "raw",
          "raw": "{\"expectedVersion\":0}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.expect(pm.response.code).to.be.oneOf([200,202]);"
            ]
          }
        }
      ]
    },
    {
      "name": "TRIP-13 Cancel synthetic trip once",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{t}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "pbl6-r3-trip-cancel-same-key"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:5080/api/v1/operator/trips/{{cancelTripId}}/cancel",
        "body": {
          "mode": "raw",
          "raw": "{\"reason\":\"Round 3 idempotency test trip\",\"expectedVersion\":1}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Trip cancellation accepted',()=>pm.response.to.have.status(202));"
            ]
          }
        }
      ]
    },
    {
      "name": "TRIP-13 Replay same cancellation key and body",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{t}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "pbl6-r3-trip-cancel-same-key"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:5080/api/v1/operator/trips/{{cancelTripId}}/cancel",
        "body": {
          "mode": "raw",
          "raw": "{\"reason\":\"Round 3 idempotency test trip\",\"expectedVersion\":1}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Duplicate cancellation replays accepted result',()=>pm.response.to.have.status(202));"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify trip cancelled",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:5080/api/v1/trips/{{cancelTripId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Trip remains cancelled after idempotent replay',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().status).to.eql('CANCELLED')});"
            ]
          }
        }
      ]
    }
  ]
}