{
    "info":  {
                 "name":  "PBL6 Round 3 inspect isolated trip",
                 "schema":  "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
             },
    "item":  [
                 {
                     "name":  "Operator login",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "http://localhost:5080/api/v1/auth/login",
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\"identifier\":\"operator.seed@example.test\",\"password\":\"OperatorPass1\"}"
                                              }
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "pm.response.to.have.status(200);pm.environment.set(\u0027t\u0027,pm.response.json().accessToken)"
                                                               ]
                                                  }
                                   }
                               ]
                 },
                 {
                     "name":  "Read isolated trip",
                     "request":  {
                                     "method":  "GET",
                                     "header":  [
                                                    {
                                                        "key":  "Authorization",
                                                        "value":  "Bearer {{t}}"
                                                    }
                                                ],
                                     "url":  "http://localhost:5080/api/v1/trips/{{tripId}}"
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "console.log(\u0027PUBLIC TRIP READBACK \u0027+pm.response.text())"
                                                               ]
                                                  }
                                   }
                               ]
                 }
             ]
}
