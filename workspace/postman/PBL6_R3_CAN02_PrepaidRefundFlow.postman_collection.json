{
    "info":  {
                 "name":  "PBL6 Round 3 synthetic prepaid payment and cancellation refund workflow",
                 "schema":  "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
             },
    "item":  [
                 {
                     "name":  "Customer login",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "http://localhost:5080/api/v1/auth/login",
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\"identifier\":\"seed.customer@example.test\",\"password\":\"CustomerPass1\"}"
                                              }
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "pm.response.to.have.status(200);pm.environment.set(\u0027t\u0027,pm.response.json().accessToken)"
                                                               ]
                                                  }
                                   }
                               ]
                 },
                 {
                     "name":  "Read available seats on active synthetic trip",
                     "request":  {
                                     "method":  "GET",
                                     "header":  [
                                                    {
                                                        "key":  "Authorization",
                                                        "value":  "Bearer {{t}}"
                                                    }
                                                ],
                                     "url":  "http://localhost:5080/api/v1/trips/01990a00-0000-7000-8000-000000000007/seats"
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "pm.test(\u0027Available seat found\u0027,()=\u003e{pm.response.to.have.status(200);const s=pm.response.json().seats.find(x=\u003ex.status===\u0027AVAILABLE\u0027);pm.expect(s).to.exist;pm.environment.set(\u0027seat\u0027,s.id)});pm.environment.set(\u0027p\u0027,\u002701990a00-0000-7000-8000-000000000004\u0027);pm.environment.set(\u0027d\u0027,\u002701990a00-0000-7000-8000-000000000005\u0027)"
                                                               ]
                                                  }
                                   }
                               ]
                 },
                 {
                     "name":  "Hold one seat for prepaid cancellation fixture",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Authorization",
                                                        "value":  "Bearer {{t}}"
                                                    },
                                                    {
                                                        "key":  "Idempotency-Key",
                                                        "value":  "{{$guid}}"
                                                    },
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "http://localhost:5080/api/v1/trips/01990a00-0000-7000-8000-000000000007/seat-holds",
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\"seatIds\":[\"{{seat}}\"],\"pickupStopId\":\"{{p}}\",\"dropoffStopId\":\"{{d}}\"}"
                                              }
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "pm.response.to.have.status(201);pm.environment.set(\u0027hold\u0027,pm.response.json().holdToken)"
                                                               ]
                                                  }
                                   }
                               ]
                 },
                 {
                     "name":  "Create synthetic PREPAID booking",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Authorization",
                                                        "value":  "Bearer {{t}}"
                                                    },
                                                    {
                                                        "key":  "Idempotency-Key",
                                                        "value":  "{{$guid}}"
                                                    },
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "http://localhost:5080/api/v1/bookings",
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\"holdToken\":\"{{hold}}\",\"contact\":{\"fullName\":\"PBL6 Round 3 Prepaid Cancellation\",\"email\":\"seed.customer@example.test\",\"phone\":\"+840000000001\"},\"passengers\":[{\"seatId\":\"{{seat}}\",\"fullName\":\"PBL6 Round 3 Refund Passenger\",\"pickupStopId\":\"{{p}}\",\"dropoffStopId\":\"{{d}}\"}],\"expectedTotal\":150000,\"currency\":\"VND\",\"paymentChannel\":\"PREPAID\"}"
                                              }
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "console.log(\u0027CAN02 BOOKING \u0027+pm.response.text());pm.test(\u0027Prepaid booking created\u0027,()=\u003e{pm.response.to.have.status(201);pm.environment.set(\u0027booking\u0027,pm.response.json().id)})"
                                                               ]
                                                  }
                                   }
                               ]
                 },
                 {
                     "name":  "Create VNPAY sandbox payment intent",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Authorization",
                                                        "value":  "Bearer {{t}}"
                                                    },
                                                    {
                                                        "key":  "Idempotency-Key",
                                                        "value":  "{{$guid}}"
                                                    },
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "http://localhost:5080/api/v1/bookings/{{booking}}/payments",
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\"provider\":\"VNPAY_SANDBOX\",\"method\":\"VNPAY_QR\",\"returnUri\":\"http://localhost:5173/payment/result\"}"
                                              }
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "console.log(\u0027CAN02 PAYMENT \u0027+pm.response.text());pm.test(\u0027VNPAY sandbox intent created\u0027,()=\u003e{pm.response.to.have.status(201);const p=pm.response.json();pm.environment.set(\u0027payment\u0027,p.id);const u=new URL(p.providerAction.redirectUri);for(const k of [\u0027vnp_TxnRef\u0027,\u0027vnp_Amount\u0027,\u0027vnp_ReturnUrl\u0027,\u0027vnp_OrderInfo\u0027])pm.environment.set(k,u.searchParams.get(k))})"
                                                               ]
                                                  }
                                   }
                               ]
                 },
                 {
                     "name":  "Complete local signed VNPAY payment",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/x-www-form-urlencoded"
                                                    }
                                                ],
                                     "url":  "http://localhost:8099/pay",
                                     "body":  {
                                                  "mode":  "urlencoded",
                                                  "urlencoded":  [
                                                                     {
                                                                         "key":  "vnp_TxnRef",
                                                                         "value":  "{{vnp_TxnRef}}"
                                                                     },
                                                                     {
                                                                         "key":  "vnp_Amount",
                                                                         "value":  "{{vnp_Amount}}"
                                                                     },
                                                                     {
                                                                         "key":  "vnp_ReturnUrl",
                                                                         "value":  "{{vnp_ReturnUrl}}"
                                                                     },
                                                                     {
                                                                         "key":  "vnp_OrderInfo",
                                                                         "value":  "{{vnp_OrderInfo}}"
                                                                     },
                                                                     {
                                                                         "key":  "outcome",
                                                                         "value":  "00"
                                                                     }
                                                                 ]
                                              },
                                     "protocolProfileBehavior":  {
                                                                     "followRedirects":  false
                                                                 }
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "console.log(\u0027CAN02 SIMULATOR \u0027+pm.response.code+\u0027 \u0027+pm.response.text());pm.test(\u0027Simulator returned redirect after signed callback\u0027,()=\u003epm.expect(pm.response.code).to.be.oneOf([200,302,303]));"
                                                               ]
                                                  }
                                   }
                               ]
                 },
                 {
                     "name":  "Verify payment succeeded",
                     "request":  {
                                     "method":  "GET",
                                     "header":  [
                                                    {
                                                        "key":  "Authorization",
                                                        "value":  "Bearer {{t}}"
                                                    }
                                                ],
                                     "url":  "http://localhost:5080/api/v1/payments/{{payment}}"
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "pm.test(\u0027Synthetic payment succeeded\u0027,()=\u003e{pm.response.to.have.status(200);pm.expect(pm.response.json().status).to.eql(\u0027SUCCEEDED\u0027)})"
                                                               ]
                                                  }
                                   }
                               ]
                 },
                 {
                     "name":  "Read booking paid state and version",
                     "request":  {
                                     "method":  "GET",
                                     "header":  [
                                                    {
                                                        "key":  "Authorization",
                                                        "value":  "Bearer {{t}}"
                                                    }
                                                ],
                                     "url":  "http://localhost:5080/api/v1/bookings/{{booking}}"
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "const b=pm.response.json();",
                                                                   "const attempt=Number(pm.environment.get(\u0027paidPollAttempt\u0027)||0);",
                                                                   "if(b.status!==\u0027PAID\u0027 \u0026\u0026 attempt\u003c20){pm.environment.set(\u0027paidPollAttempt\u0027,attempt+1);pm.execution.setNextRequest(\u0027Read booking paid state and version\u0027);setTimeout(()=\u003e{},250);}",
                                                                   "else{pm.environment.unset(\u0027paidPollAttempt\u0027);pm.test(\u0027Booking converges to PAID\u0027,()=\u003e{pm.response.to.have.status(200);pm.expect(b.status).to.eql(\u0027PAID\u0027)});pm.environment.set(\u0027version\u0027,b.rowVersion);}"
                                                               ]
                                                  }
                                   }
                               ]
                 },
                 {
                     "name":  "Find ticket for synthetic prepaid booking",
                     "request":  {
                                     "method":  "GET",
                                     "header":  [
                                                    {
                                                        "key":  "Authorization",
                                                        "value":  "Bearer {{t}}"
                                                    }
                                                ],
                                     "url":  "http://localhost:5080/api/v1/tickets"
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "pm.test(\u0027Ticket was issued for paid booking\u0027,()=\u003e{pm.response.to.have.status(200);const b=pm.response.json();const t=b.items.find(x=\u003ex.bookingId===pm.environment.get(\u0027booking\u0027));pm.expect(t).to.exist;pm.environment.set(\u0027ticket\u0027,t.id)})"
                                                               ]
                                                  }
                                   }
                               ]
                 },
                 {
                     "name":  "Preview PREPAID cancellation",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Authorization",
                                                        "value":  "Bearer {{t}}"
                                                    },
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "http://localhost:5080/api/v1/bookings/{{booking}}/cancellation-preview",
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\"ticketIds\":[\"{{ticket}}\"]}"
                                              }
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "console.log(\u0027CAN02 PREVIEW \u0027+pm.response.text());pm.test(\u0027Paid synthetic ticket has refund preview\u0027,()=\u003e{pm.response.to.have.status(200);const b=pm.response.json();pm.expect(b.refundAmount).to.be.a(\u0027number\u0027);pm.environment.set(\u0027preview\u0027,b.previewId)})"
                                                               ]
                                                  }
                                   }
                               ]
                 },
                 {
                     "name":  "CAN-02 Confirm cancellation of synthetic paid ticket",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Authorization",
                                                        "value":  "Bearer {{t}}"
                                                    },
                                                    {
                                                        "key":  "Idempotency-Key",
                                                        "value":  "{{$guid}}"
                                                    },
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "http://localhost:5080/api/v1/bookings/{{booking}}/cancel",
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\"previewId\":\"{{preview}}\",\"reason\":\"Round 3 synthetic prepaid refund test\",\"expectedVersion\":{{version}}}"
                                              }
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "console.log(\u0027CAN02 CANCEL \u0027+pm.response.text());pm.test(\u0027Paid booking cancellation accepted\u0027,()=\u003epm.response.to.have.status(202))"
                                                               ]
                                                  }
                                   }
                               ]
                 },
                 {
                     "name":  "Read cancelled prepaid booking",
                     "request":  {
                                     "method":  "GET",
                                     "header":  [
                                                    {
                                                        "key":  "Authorization",
                                                        "value":  "Bearer {{t}}"
                                                    }
                                                ],
                                     "url":  "http://localhost:5080/api/v1/bookings/{{booking}}"
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "console.log(\u0027CAN02 BOOKING READBACK \u0027+pm.response.text())"
                                                               ]
                                                  }
                                   }
                               ]
                 }
             ]
}