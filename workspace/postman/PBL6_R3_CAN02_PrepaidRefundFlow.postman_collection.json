{"info":{"name":"PBL6 Round 3 synthetic prepaid payment and cancellation refund workflow","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"name":"Customer login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/auth/login","body":{"mode":"raw","raw":"{\"identifier\":\"seed.customer@example.test\",\"password\":\"CustomerPass1\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.response.to.have.status(200);pm.environment.set('t',pm.response.json().accessToken)"]}}]},{"name":"Read available seats on active synthetic trip","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{t}}"}],"url":"http://localhost:5080/api/v1/trips/01a1825e-ce81-77ac-a288-7ec225093288/seats"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Available seat found',()=>{pm.response.to.have.status(200);const s=pm.response.json().seats.find(x=>x.status==='AVAILABLE');pm.expect(s).to.exist;pm.environment.set('seat',s.id)});pm.environment.set('p','01990a00-0000-7000-8000-000000000004');pm.environment.set('d','01990a00-0000-7000-8000-000000000005')"]}}]},{"name":"Hold one seat for prepaid cancellation fixture","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{t}}"},{"key":"Idempotency-Key","value":"pbl6-r3-can02-hold"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/trips/01a1825e-ce81-77ac-a288-7ec225093288/seat-holds","body":{"mode":"raw","raw":"{\"seatIds\":[\"{{seat}}\"],\"pickupStopId\":\"{{p}}\",\"dropoffStopId\":\"{{d}}\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.response.to.have.status(201);pm.environment.set('hold',pm.response.json().holdToken)"]}}]},{"name":"Create synthetic PREPAID booking","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{t}}"},{"key":"Idempotency-Key","value":"pbl6-r3-can02-booking"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/bookings","body":{"mode":"raw","raw":"{\"holdToken\":\"{{hold}}\",\"contact\":{\"fullName\":\"PBL6 Round 3 Prepaid Cancellation\",\"email\":\"seed.customer@example.test\",\"phone\":\"+840000000001\"},\"passengers\":[{\"seatId\":\"{{seat}}\",\"fullName\":\"PBL6 Round 3 Refund Passenger\",\"pickupStopId\":\"{{p}}\",\"dropoffStopId\":\"{{d}}\"}],\"expectedTotal\":150000,\"currency\":\"VND\",\"paymentChannel\":\"PREPAID\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["console.log('CAN02 BOOKING '+pm.response.text());pm.test('Prepaid booking created',()=>{pm.response.to.have.status(201);pm.environment.set('booking',pm.response.json().id)})"]}}]},{"name":"Create VNPAY sandbox payment intent","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{t}}"},{"key":"Idempotency-Key","value":"pbl6-r3-can02-payment"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/bookings/{{booking}}/payments","body":{"mode":"raw","raw":"{\"provider\":\"VNPAY_SANDBOX\",\"method\":\"VNPAY_QR\",\"returnUri\":\"http://localhost:5173/payment/result\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["console.log('CAN02 PAYMENT '+pm.response.text());pm.test('VNPAY sandbox intent created',()=>{pm.response.to.have.status(201);const p=pm.response.json();pm.environment.set('payment',p.id);const u=new URL(p.providerAction.redirectUri);for(const k of ['vnp_TxnRef','vnp_Amount','vnp_ReturnUrl','vnp_OrderInfo'])pm.environment.set(k,u.searchParams.get(k))})"]}}]},{"name":"Complete local signed VNPAY payment","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/x-www-form-urlencoded"}],"url":"http://localhost:8099/pay","body":{"mode":"urlencoded","urlencoded":[{"key":"vnp_TxnRef","value":"{{vnp_TxnRef}}"},{"key":"vnp_Amount","value":"{{vnp_Amount}}"},{"key":"vnp_ReturnUrl","value":"{{vnp_ReturnUrl}}"},{"key":"vnp_OrderInfo","value":"{{vnp_OrderInfo}}"},{"key":"outcome","value":"00"}]},"protocolProfileBehavior":{"followRedirects":false}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["console.log('CAN02 SIMULATOR '+pm.response.code+' '+pm.response.text());pm.test('Simulator returned redirect after signed callback',()=>pm.expect(pm.response.code).to.be.oneOf([302,303]));"]}}]},{"name":"Verify payment succeeded","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{t}}"}],"url":"http://localhost:5080/api/v1/payments/{{payment}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Synthetic payment succeeded',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().status).to.eql('SUCCEEDED')})"]}}]},{"name":"Read booking paid state and version","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{t}}"}],"url":"http://localhost:5080/api/v1/bookings/{{booking}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.response.to.have.status(200);pm.expect(pm.response.json().status).to.eql('PAID');pm.environment.set('version',pm.response.json().rowVersion)"]}}]},{"name":"Find ticket for synthetic prepaid booking","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{t}}"}],"url":"http://localhost:5080/api/v1/tickets"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Ticket was issued for paid booking',()=>{pm.response.to.have.status(200);const b=pm.response.json();const t=b.items.find(x=>x.bookingId===pm.environment.get('booking'));pm.expect(t).to.exist;pm.environment.set('ticket',t.id)})"]}}]},{"name":"Preview PREPAID cancellation","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{t}}"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/bookings/{{booking}}/cancellation-preview","body":{"mode":"raw","raw":"{\"ticketIds\":[\"{{ticket}}\"]}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["console.log('CAN02 PREVIEW '+pm.response.text());pm.test('Paid synthetic ticket has refund preview',()=>{pm.response.to.have.status(200);const b=pm.response.json();pm.expect(b.refundAmount).to.be.a('number');pm.environment.set('preview',b.previewId)})"]}}]},{"name":"CAN-02 Confirm cancellation of synthetic paid ticket","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{t}}"},{"key":"Idempotency-Key","value":"pbl6-r3-can02-cancel"},{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:5080/api/v1/bookings/{{booking}}/cancel","body":{"mode":"raw","raw":"{\"previewId\":\"{{preview}}\",\"reason\":\"Round 3 synthetic prepaid refund test\",\"expectedVersion\":{{version}}}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["console.log('CAN02 CANCEL '+pm.response.text());pm.test('Paid booking cancellation accepted',()=>pm.response.to.have.status(202))"]}}]},{"name":"Read cancelled prepaid booking","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{t}}"}],"url":"http://localhost:5080/api/v1/bookings/{{booking}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["console.log('CAN02 BOOKING READBACK '+pm.response.text())"]}}]}]}
