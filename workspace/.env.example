# ASP.NET
ASPNETCORE_ENVIRONMENT=Development

# API Gateway
API_GATEWAY_PORT=5050

# RabbitMQ
RABBITMQ_HOST=messagebroker
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=identity_app
RABBITMQ_PASSWORD=replace-with-a-local-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_FROM=your-email@gmail.com
SMTP_USERNAME=your-email@gmail.com
SMTP_APP_PASSWORD=replace-with-google-app-password

# ==================================================
# IDENTITY SERVICE
# ==================================================

# Identity API
IDENTITY_API_PORT=8080

# Identity Database - PostgreSQL
IDENTITY_DB_HOST=identity-db
IDENTITY_DB_PORT=5432
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity_app
IDENTITY_DB_PASSWORD=replace-with-a-local-password

# Identity security
VERIFICATION_SECRET=replace-with-a-random-verification-secret
OTP_RESEND_COOLDOWN_SECONDS=60
