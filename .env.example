# Local secrets — never commit real values
POSTGRES_PASSWORD=postgres
RABBITMQ_PASSWORD=guest
JWT_SIGNING_KEY=local-dev-only-change-me-32bytes-min
# Enable only with a working SMS adapter. The adapter accepts HTTPS POST {to,message} with Bearer authorization.
SEAT_REQUIRE_VERIFIED_PHONE=false
SMS_ENDPOINT=
SMS_TOKEN=
MESSAGING__AMQPURI=amqp://platform:guest@localhost:5672/bus-ticket

# SePay Payment Gateway: backend only; never prefix secrets with VITE_.
SEPAY_ENVIRONMENT=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# Independent shared secret, also configure SePay IPN auth type SECRET_KEY.
SEPAY_IPN_SECRET_KEY=
# Public HTTPS customer origin for SePay browser callbacks (no trailing path).
CUSTOMER_PUBLIC_ORIGIN=http://localhost:5173
